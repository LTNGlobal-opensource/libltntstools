// Place your settings in this file to overwrite default and user settings.
{
    // Configure glob patterns for excluding files and folders.
    "files.exclude": {
        "**/.git": true,
        "**/.svn": true,
        "**/.hg": true,
        "**/.DS_Store": true,
        "**/.lo": true,
        "**/*.lo": true,
        "**/*.Po": true,
        "**/*.la": true,
        "**/*.o": true,
        "**/Makefile": true,
        "**/Makefile.in": true,
        "**/.libs": true,
        "**/.deps": true,
        "**/m4": true,
        "**/autom4te.cache": true,
        "config.*": true,
        "configure": true,
        "install-sh": true,
        "aclocal.m4": true,
        "compile": true,
        "libtool": true,
        "ltmain.sh": true,
        "missing": true,
        "depcomp": true,
        "**/core.*": true,
        "**/*.dSYM": true,
        "**/test_crc32": true,
        "**/test_history_metric": true,
        "**/test_ts": true,
        "**/test_reframer": true,
        "**/test_stats": true,
        "**/test_descriptor": true,
        "**/test_pes": true,
        "**/test_pat": true,
        "**/test_sectionextractor": true,
        "**/test_ts_packetizer": true,
        "**/test_throughput_hires": true,
        "**/test_time": true,
        "**/test_throughput": true,
        "**/test_streammodel": true,
        "**/test_streammodel_extractors": true,
        "**/test_pes_extractor": true,
        "**/test_sei_timestamp": true,
        "**/test_smoother_pcr": true,
        "**/test_probes": true,
        "**/test_smoother_rtp": true,
        "**/test_segmentwriter": true,
        "**/test_klbitstream_readwriter": true,
        "**/test_tr101290": true,
        "**/test_nal_bitreader": true,
    },
    "files.associations": {
        "*h*h*h*hfunctional": "cpp",
        "functional": "cpp",
        "*.tcc": "cpp",
        "streambuf": "cpp",
        "algorithm": "cpp",
        "limits": "cpp",
        "type_traits": "cpp",
        "utility": "cpp"
    },
    "editor.formatOnSave": false
}
